local SpeedForce = nil

local function getActiveSpeed()
    if State.Lagger then
        return State.Carry and State.LaggerCarrySpeed or State.LaggerSpeed
    end
    return State.Carry and State.CarrySpeed or State.NormalSpeed
end
getgenv().MellGetSpeed = getActiveSpeed

local function setupSpeedForce(hrp)
    if SpeedForce and SpeedForce.Parent == hrp then return end
    if SpeedForce then SpeedForce:Destroy() end
    SpeedForce = Instance.new("BodyForce")
    SpeedForce.Name   = "MellSpeedBF"
    SpeedForce.Force  = Vector3.zero
    SpeedForce.Parent = hrp
end

RunService.RenderStepped:Connect(function()
    local char = getChar()
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    setupSpeedForce(hrp)
    if not SpeedForce then return end

    local dir = hum.MoveDirection
    if dir.Magnitude > 0.1 then
        local target = dir * getActiveSpeed()
        local vel    = hrp.AssemblyLinearVelocity
        local diff   = target - Vector3.new(vel.X, 0, vel.Z)
        local mass   = hrp:GetMass() or 2
        local force  = diff * mass / 0.016
        SpeedForce.Force = Vector3.new(force.X, 0, force.Z)
    else
        SpeedForce.Force = Vector3.zero
    end
end)

