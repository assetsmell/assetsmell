-- TP BAT (V1 / V2)
--============================================================
local tpBatConn  = nil
local tpbH       = nil
local tpbHrp     = nil
local tpbHitCd   = false
local TPB_VERSION = "V1"

local function tpbSetupChar(char)
    if not char then return end
    tpbH   = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    tpbHrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
end

LP.CharacterAdded:Connect(function(char)
    task.spawn(function()
        task.wait(0.1)
        tpbSetupChar(char)
    end)
end)
if LP.Character then task.spawn(function() tpbSetupChar(LP.Character) end) end

local function tpbHit()
    if tpbHitCd then return end
    tpbHitCd = true
    local char = getChar()
    if char then
        local bat = findBat()
        if bat then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if bat.Parent ~= char and hum then
                pcall(function() hum:EquipTool(bat) end)
            end
            pcall(function() bat:Activate() end)
            local ev = bat:FindFirstChildWhichIsA("RemoteEvent")
            if ev then pcall(function() ev:FireServer() end) end
        end
    end
    task.delay(0.08, function() tpbHitCd = false end)
end

-- V1: ближайший игрок, distance > 8 → tp
local function tpbV1Update()
    if not State.TPBat or TPB_VERSION ~= "V1" then return end
    local char = getChar()
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local target = getClosestTargetRoot()
    if not target then return end
    if sethiddenproperty then
        pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", target) end)
    end
    local tpPos = target.Position + Vector3.new(0, 0.9, 0)
    if (hrp.Position - tpPos).Magnitude > 8 then
        hrp.CFrame = CFrame.new(tpPos)
    end
    local cam = workspace.CurrentCamera
    if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, target.Position) end
    tpbHit()
end

-- V2: дистанция > 3 → tp
local function tpbV2Update()
    if not State.TPBat or TPB_VERSION ~= "V2" then return end
    if not (tpbH and tpbHrp) then return end
    local target = getClosestTargetRoot()
    if not target then return end
    if sethiddenproperty then
        pcall(function() sethiddenproperty(tpbHrp, "PhysicsRepRootPart", target) end)
    end
    local tpPos = target.Position + Vector3.new(0, 0.9, 0)
    if (tpbHrp.Position - tpPos).Magnitude > 3 then
        tpbHrp.CFrame = CFrame.new(tpPos)
    end
    local cam = workspace.CurrentCamera
    if cam then cam.CFrame = CFrame.new(cam.CFrame.Position, target.Position) end
    tpbHit()
end

local function startTPBat(version)
    TPB_VERSION = version or TPB_VERSION
    if tpBatConn then tpBatConn:Disconnect(); tpBatConn = nil end
    if TPB_VERSION == "V2" then
        tpBatConn = RunService.Heartbeat:Connect(tpbV2Update)
    else
        tpBatConn = RunService.Heartbeat:Connect(tpbV1Update)
    end
end

local function stopTPBat()
    if tpBatConn then tpBatConn:Disconnect(); tpBatConn = nil end
    local hrp = tpbHrp or getHRP()
    if hrp and sethiddenproperty then
        pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", hrp) end)
    end
end
getgenv().MellStartTPBat = startTPBat
getgenv().MellStopTPBat  = stopTPBat
getgenv().MellSetTPBatVersion = function(v) TPB_VERSION = v end

--============================================================
-- DROP / TP DOWN (используется мобильными кнопками в Части 5)
--============================================================
local function drop()
    local char = getChar()
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 150, hrp.AssemblyLinearVelocity.Z)
    task.spawn(function()
        task.wait(0.2)
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {char}
        params.FilterType = Enum.RaycastFilterType.Exclude
        local result = workspace:Raycast(hrp.Position, Vector3.new(0, -2000, 0), params)
        if result then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local offset = (hum and hum.HipHeight or 2) + hrp.Size.Y / 2
            hrp.CFrame = CFrame.new(hrp.Position.X, result.Position.Y + offset, hrp.Position.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

local function tpDown()
    local hrp = getHRP()
    if not hrp then return end
    hrp.CFrame = CFrame.new(hrp.Position.X, -7, hrp.Position.Z)
    hrp.AssemblyLinearVelocity = Vector3.zero
end
getgenv().MellDrop  = drop
getgenv().MellTPDown = tpDown

