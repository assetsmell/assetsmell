--============================================================
-- AUTO PATH (Auto Left / Auto Right)
--============================================================
local AP_LEFT  = {
    Vector3.new(-476.47, -6.28, 92.73),
    Vector3.new(-483.12, -4.95, 94.81),
    Vector3.new(-476.12, -6.59, 92.24),
    Vector3.new(-467.23, -6.99, 22.54),
}
local AP_RIGHT = {
    Vector3.new(-476.16, -6.52, 25.62),
    Vector3.new(-483.06, -5.03, 25.48),
    Vector3.new(-476.58, -6.49, 28.32),
    Vector3.new(-468.26, -6.99, 97.54),
}

local autoLeftConn, autoRightConn = nil, nil
local autoLeftIdx, autoRightIdx   = 1, 1
local _lvBoost = nil

local function ensureLV(hrp)
    if _lvBoost and _lvBoost.Parent == hrp then return end
    if _lvBoost then _lvBoost:Destroy() end
    local att = Instance.new("Attachment")
    att.Name = "MellAutoPathAtt"
    att.Parent = hrp
    local lv = Instance.new("LinearVelocity")
    lv.Name = "MellAutoPathLV"
    lv.Attachment0 = att
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
    lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
    lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
    lv.MaxForce = 2200
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.Parent = hrp
    _lvBoost = lv
end

local function pathToPoint(hrp, hum, point, speed)
    local delta = point - hrp.Position
    local flat  = Vector3.new(delta.X, 0, delta.Z)
    if flat.Magnitude <= 1.5 then
        hum:Move(Vector3.zero, false)
        if _lvBoost then _lvBoost.PlaneVelocity = Vector2.zero end
        return true
    end
    local dir = flat.Unit
    hum:Move(dir, false)
    ensureLV(hrp)
    if _lvBoost then
        _lvBoost.PlaneVelocity = Vector2.new(dir.X * speed, dir.Z * speed)
    end
    return false
end

local function startAutoLeft()
    if autoLeftConn then autoLeftConn:Disconnect() end
    autoLeftIdx = 1
    autoLeftConn = RunService.Heartbeat:Connect(function()
        if not State.AutoLeft then return end
        local char = getChar()
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        if hum.PlatformStand then hum:Move(Vector3.zero, false); return end

        local point = AP_LEFT[autoLeftIdx]
        local speed = getgenv().MellGetSpeed and getgenv().MellGetSpeed() or 30
        if pathToPoint(hrp, hum, point, speed) then
            autoLeftIdx = autoLeftIdx % #AP_LEFT + 1
        end
    end)
end

local function stopAutoLeft()
    if autoLeftConn then autoLeftConn:Disconnect(); autoLeftConn = nil end
    if _lvBoost then _lvBoost.PlaneVelocity = Vector2.zero end
    local hum = getHum()
    if hum then hum:Move(Vector3.zero, false) end
end

local function startAutoRight()
    if autoRightConn then autoRightConn:Disconnect() end
    autoRightIdx = 1
    autoRightConn = RunService.Heartbeat:Connect(function()
        if not State.AutoRight then return end
        local char = getChar()
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        if hum.PlatformStand then hum:Move(Vector3.zero, false); return end

        local point = AP_RIGHT[autoRightIdx]
        local speed = getgenv().MellGetSpeed and getgenv().MellGetSpeed() or 30
        if pathToPoint(hrp, hum, point, speed) then
            autoRightIdx = autoRightIdx % #AP_RIGHT + 1
        end
    end)
end

local function stopAutoRight()
    if autoRightConn then autoRightConn:Disconnect(); autoRightConn = nil end
    if _lvBoost then _lvBoost.PlaneVelocity = Vector2.zero end
    local hum = getHum()
    if hum then hum:Move(Vector3.zero, false) end
end

