-- AUTO TP (телепорт на высоту при падении)
--============================================================
local autoTPToken = nil
local function startAutoTP()
    if autoTPToken then return end
    local token = {}
    autoTPToken = token
    task.spawn(function()
        while autoTPToken == token and State.AutoTP do
            local char = getChar()
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
