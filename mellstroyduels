local HOTKEYS = {
    [Enum.KeyCode.Q] = function() State.Lagger = not State.Lagger end,            -- Lagger toggle
    [Enum.KeyCode.C] = function() State.Carry = not State.Carry end,               -- Carry toggle
    [Enum.KeyCode.F] = function()                                                  -- Bat Aimbot toggle
        State.BatAimbot = not State.BatAimbot
        if State.BatAimbot then
            if getgenv().MellStartBatAimbot then getgenv().MellStartBatAimbot() end
            if getgenv().MellStartAutoSwing then getgenv().MellStartAutoSwing() end
        else
            if getgenv().MellStopBatAimbot then getgenv().MellStopBatAimbot() end
        end
    end,
    [Enum.KeyCode.B] = function()                                                  -- TP Bat toggle
        State.TPBat = not State.TPBat
        if State.TPBat then
            if getgenv().MellStartTPBat then getgenv().MellStartTPBat("V1") end
            if getgenv().MellStartAutoSwing then getgenv().MellStartAutoSwing() end
        else
            if getgenv().MellStopTPBat then getgenv().MellStopTPBat() end
        end
    end,
    [Enum.KeyCode.H] = function() if getgenv().MellDrop then getgenv().MellDrop() end end,
    [Enum.KeyCode.T] = function() if getgenv().MellTPDown then getgenv().MellTPDown() end end,
    [Enum.KeyCode.Z] = function()
        State.AutoLeft = not State.AutoLeft
        if State.AutoLeft then
            if getgenv().MellStartAutoLeft then getgenv().MellStartAutoLeft() end
        else
            if getgenv().MellStopAutoLeft then getgenv().MellStopAutoLeft() end
        end
    end,
    [Enum.KeyCode.X] = function()
        State.AutoRight = not State.AutoRight
        if State.AutoRight then
            if getgenv().MellStartAutoRight then getgenv().MellStartAutoRight() end
        else
            if getgenv().MellStopAutoRight then getgenv().MellStopAutoRight() end
        end
    end,
    [Enum.KeyCode.LeftControl] = function()
        if gui.Enabled then
            duelsUI.Visible = not duelsUI.Visible
        else
            gui.Enabled = true
            duelsUI.Visible = true
        end
    end,
}

UserInput.InputBegan:Connect(function(input, gp)
    if gp then return end
    if UserInput:GetFocusedTextBox() then return end
    local fn = HOTKEYS[input.KeyCode]
    if fn then pcall(fn) end
end)

