-- ОБЩИЕ ХЕЛПЕРЫ
--============================================================
local function findBat()
    local char = getChar()
    if not char then return nil end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find("bat") then return t end
    end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower():find("bat") then return t end
        end
    end
    return nil
end
getgenv().MellFindBat = findBat

local function getClosestTargetRoot()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c = p.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local h = c and c:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - hrp.Position).Magnitude
                if d < bestDist then best = r; bestDist = d end
            end
        end
    end
    return best
end
getgenv().MellGetClosestTarget = getClosestTargetRoot

--============================================================
-- BAT AIMBOT
--============================================================
local aimbotConn = nil
local swingCd    = false

local function startBatAimbot()
    if aimbotConn then return end
    local hum = getHum()
    if hum then hum.AutoRotate = false end

    aimbotConn = RunService.RenderStepped:Connect(function()
        if not State.BatAimbot then return end
        local char = getChar()
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        -- авто-экип биты
        local bat = findBat()
        if bat and bat.Parent ~= char then
            pcall(function() hum:EquipTool(bat) end)
        end

        local target = getClosestTargetRoot()
        if not target then return end

        local myPos  = hrp.Position
        local tPos   = target.Position
        local tVel   = target.AssemblyLinearVelocity
        local predict = tPos + tVel * 0.14 + target.CFrame.LookVector * 0.3

        local dir = predict - myPos
        if dir.Magnitude < 0.1 then return end

        local flat = Vector3.new(dir.X, 0, dir.Z)
        if flat.Magnitude < 0.01 then return end
        flat = flat.Unit

        -- chase скорость
        local chaseSpeed = State.Lagger and 40 or 50
        local desiredHeight = tPos.Y + 3.7
        local yVel = (desiredHeight - myPos.Y) * 19.5 + tVel.Y * 0.8
        if hum.FloorMaterial ~= Enum.Material.Air then
            yVel = math.max(yVel, 13)
        end
        yVel = math.clamp(yVel, -70, 110)

        hrp.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity:Lerp(
            Vector3.new(flat.X * chaseSpeed, yVel, flat.Z * chaseSpeed), 0.8
        )

        -- поворот к цели
        local predictTime = math.clamp(tVel.Magnitude / 150, 0.05, 0.2)
        local predictedPos = tPos + tVel * predictTime
        local toPredict = predictedPos - myPos
        if toPredict.Magnitude > 0.1 then
            local goalCF = CFrame.lookAt(myPos, predictedPos)
            local diffCF = hrp.CFrame:Inverse() * goalCF
            local rx, ry, rz = diffCF:ToEulerAnglesXYZ()
            hrp.AssemblyAngularVelocity = hrp.CFrame:VectorToWorldSpace(Vector3.new(
                math.clamp(rx, -2.5, 2.5) * 42,
                math.clamp(ry, -2.5, 2.5) * 42,
                math.clamp(rz, -2.5, 2.5) * 42
            ))
        end

        -- авто-свинг при BatAimbot
        if State.AutoSwing and bat and not swingCd then
            local d = (tPos - myPos).Magnitude
            if d <= 13 then
                swingCd = true
                pcall(function() bat:Activate() end)
                task.delay(0.08, function() swingCd = false end)
            end
        end
    end)
end

local function stopBatAimbot()
    if aimbotConn then aimbotConn:Disconnect(); aimbotConn = nil end
    local char = getChar()
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum then hum.AutoRotate = true end
        if hrp then
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
end
getgenv().MellStartBatAimbot = startBatAimbot
getgenv().MellStopBatAimbot  = stopBatAimbot

--============================================================
-- BAT COUNTER (авто-удар при ragdoll)
--============================================================
local batCounterToken = nil
local batCounterCd    = false

local function startBatCounter()
    if batCounterToken then return end
    local token = {}
    batCounterToken = token

    task.spawn(function()
        while batCounterToken == token and State.BatCounter do
            if not batCounterCd then
                local hum = getHum()
                if hum then
                    local st = hum:GetState()
                    local isRag = st == Enum.HumanoidStateType.Physics
                        or st == Enum.HumanoidStateType.Ragdoll
                        or st == Enum.HumanoidStateType.FallingDown
                    if isRag then
                        batCounterCd = true
                        local char = getChar()
                        local bat  = findBat()
                        if bat and char then
                            if bat.Parent ~= char then
                                pcall(function() hum:EquipTool(bat) end)
                            end
                            pcall(function() bat:Activate() end)
                            task.wait(0.15)
                            pcall(function() bat:Activate() end)
                        end
                        task.wait(0.45)
                        batCounterCd = false
                    end
                end
            end
            task.wait(0.12)
        end
    end)
end

local function stopBatCounter()
    batCounterToken = nil
    batCounterCd    = false
end
getgenv().MellStartBatCounter = startBatCounter
getgenv().MellStopBatCounter  = stopBatCounter

--============================================================
-- AUTO SWING (когда BatAimbot / TPBat активны)
--============================================================
local autoSwingToken = nil
local autoSwingCd    = false

local function startAutoSwing()
    if autoSwingToken then return end
    local token = {}
    autoSwingToken = token

    task.spawn(function()
        while autoSwingToken == token and State.AutoSwing do
            local combatActive = State.BatAimbot or State.TPBat
            if not combatActive then
                autoSwingCd = false
            elseif not autoSwingCd then
                local target = getClosestTargetRoot()
                if target then
                    local hrp = getHRP()
                    local d = hrp and (target.Position - hrp.Position).Magnitude or 999
                    if d <= 18 then
                        local char = getChar()
                        local hum  = getHum()
                        local bat  = findBat()
                        if bat and char and hum then
                            autoSwingCd = true
                            if bat.Parent ~= char then
                                pcall(function() hum:EquipTool(bat) end)
                            end
                            pcall(function() bat:Activate() end)
                            task.wait(0.12)
                            autoSwingCd = false
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

local function stopAutoSwing()
    autoSwingToken = nil
    autoSwingCd    = false
end
getgenv().MellStartAutoSwing = startAutoSwing
getgenv().MellStopAutoSwing  = stopAutoSwing

--============================================================
-- ANTI DIE / FLING
--============================================================
local antiDieToken = nil

local function startAntiDieFling()
    if antiDieToken then return end
    local token = {}
    antiDieToken = token

    local char = getChar()
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum.BreakJointsOnDeath = false
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        end)
    end

    task.spawn(function()
        while antiDieToken == token and State.AntiDieFling do
            local char2 = getChar()
            local hum2  = char2 and char2:FindFirstChildOfClass("Humanoid")
            local hrp   = char2 and char2:FindFirstChild("HumanoidRootPart")
            if hum2 and hrp then
                -- хил при просадке
                if hum2.Health < hum2.MaxHealth then
                    pcall(function() hum2.Health = hum2.MaxHealth end)
                end
                -- анти-ragdoll
                local st = hum2:GetState()
                if st == Enum.HumanoidStateType.Physics
                    or st == Enum.HumanoidStateType.Ragdoll
                    or st == Enum.HumanoidStateType.FallingDown
                    or st == Enum.HumanoidStateType.Dead then
                    pcall(function()
                        hum2:ChangeState(Enum.HumanoidStateType.GettingUp)
                        hum2:ChangeState(Enum.HumanoidStateType.Running)
                        hum2.PlatformStand = false
                    end)
                end
                -- анти-флинг (огромная скорость)
                local v = hrp.AssemblyLinearVelocity
                if v.Magnitude > 80 then
                    hrp.AssemblyLinearVelocity  = Vector3.new(0, v.Y, 0)
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
            task.wait(0.05)
        end
    end)
end

local function stopAntiDieFling()
    antiDieToken = nil
    local hum = getHum()
    if hum then
        pcall(function()
            hum.BreakJointsOnDeath = true
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
        end)
    end
end
getgenv().MellStartAntiDieFling = startAntiDieFling
getgenv().MellStopAntiDieFling  = stopAntiDieFling

--============================================================
-- AUTO STEAL (нормальный пресет)
--============================================================
local stealing       = false
local normalProgress = 0
local STEAL_PRESETS = {
    ["75"] = 0.75,
    ["80"] = 0.80,
    ["86"] = 0.86,
    ["90"] = 0.90,
}
getgenv().MellStealPresets = STEAL_PRESETS

local function findNearestPrompt()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bestDist = nil, State.StealRadius or 61
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parent = obj.Parent
            local part = parent
            if part and not part:IsA("BasePart") then
                part = part:FindFirstChildWhichIsA("BasePart")
            end
            if part then
                local d = (part.Position - hrp.Position).Magnitude
                if d < bestDist then
                    best     = obj
                    bestDist = d
                end
            end
        end
    end
    return best
end

local function getPromptSpawn(prompt)
    if not prompt then return nil end
    local parent = prompt.Parent
    if parent and parent.Name == "PromptAttachment" then parent = parent.Parent end
    if parent and parent.Name == "Spawn" and parent:IsA("BasePart") then
        return parent.Position
    end
    return nil
end

local function isCloseToSpawn(spawnPos)
    if not spawnPos then return false end
    local hrp = getHRP()
    return hrp and (spawnPos - hrp.Position).Magnitude <= 9
end

local function executeSteal(prompt)
    if stealing or not prompt then return end
    stealing = true
    task.spawn(function()
        -- hold фаза
        if getconnections then
            local ok, conns = pcall(getconnections, prompt.PromptButtonHoldBegan)
            if ok and conns then
                for _, c in ipairs(conns) do
                    if c.Function then task.spawn(c.Function) end
                end
            end
        end

        local duration = math.max(tonumber(State.StealDuration) or 1.3, 0.05)
        local preset = STEAL_PRESETS[State.AutoStealPreset] or 0.86
        local stopPoint = duration * preset
        local startT = tick()
        local spawnPos = getPromptSpawn(prompt)

        -- ждём до stopPoint
        while stealing and State.AutoSteal and prompt.Parent do
            local elapsed = tick() - startT
            normalProgress = math.clamp(elapsed / duration, 0, preset)
            getgenv()._AS_StealProgress = normalProgress
            if elapsed >= stopPoint then break end
            task.wait()
        end

        -- ждём близости к prompt (до 2 сек)
        local waitDeadline = tick() + 2
        while stealing and State.AutoSteal and prompt.Parent
            and not isCloseToSpawn(spawnPos) and tick() < waitDeadline do
            task.wait()
        end

        -- финальная фаза
        if isCloseToSpawn(spawnPos) and stealing and State.AutoSteal and prompt.Parent then
            local remaining = math.max(duration - stopPoint, 0.01)
            local finishT = tick()
            while stealing and State.AutoSteal and prompt.Parent do
                local alpha = math.clamp((tick() - finishT) / remaining, 0, 1)
                normalProgress = preset + alpha * (1 - preset)
                getgenv()._AS_StealProgress = normalProgress
                if alpha >= 1 then break end
                task.wait()
            end

            -- trigger фаза
            if stealing and State.AutoSteal and prompt.Parent then
                if getconnections then
                    local ok, conns = pcall(getconnections, prompt.Triggered)
                    if ok and conns then
                        for _, c in ipairs(conns) do
                            if c.Function then task.spawn(c.Function) end
                        end
                    end
                end
            end
        end

        task.wait(0.06)
        stealing = false
        normalProgress = 0
        getgenv()._AS_StealProgress = 0
    end)
end

local autoStealConn = nil
local nextScan = 0

local function startAutoSteal()
    if autoStealConn then return end
    autoStealConn = RunService.Heartbeat:Connect(function()
        if not State.AutoSteal or stealing then return end
        local now = os.clock()
        if now < nextScan then return end
        nextScan = now + 0.15
        local prompt = findNearestPrompt()
        if prompt then executeSteal(prompt) end
    end)
end

local function stopAutoSteal()
    if autoStealConn then autoStealConn:Disconnect(); autoStealConn = nil end
    stealing = false
    normalProgress = 0
    getgenv()._AS_StealProgress = 0
end
getgenv().MellStartAutoSteal = startAutoSteal
getgenv().MellStopAutoSteal  = stopAutoSteal

