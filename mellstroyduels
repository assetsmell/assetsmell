local espHighlights = {}
local espConns      = {}

local function attachESP(p, c)
    if not State.ESP or p == LP or not c then return end
    local old = espHighlights[p]
    if old then pcall(function() old:Destroy() end) end
    local h = Instance.new("Highlight")
    h.Name = "MellESP"
    h.Adornee = c
    h.FillColor = Color3.fromRGB(220, 42, 62)
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.FillTransparency = 0.65
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = c
    espHighlights[p] = h
end

local function setESP(on)
    State.ESP = on == true
    -- очистка
    for _, h in pairs(espHighlights) do pcall(function() h:Destroy() end) end
    espHighlights = {}
    for _, c in ipairs(espConns) do pcall(function() c:Disconnect() end) end
    espConns = {}

    if not State.ESP then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            attachESP(p, p.Character)
            table.insert(espConns, p.CharacterAdded:Connect(function(c)
                task.wait(0.3)
                if State.ESP then attachESP(p, c) end
            end))
        end
    end
    table.insert(espConns, Players.PlayerAdded:Connect(function(p)
        if p ~= LP then
            p.CharacterAdded:Connect(function(c)
                task.wait(0.3)
                if State.ESP then attachESP(p, c) end
            end)
        end
    end))
    table.insert(espConns, Players.PlayerRemoving:Connect(function(p)
        local h = espHighlights[p]
        if h then pcall(function() h:Destroy() end) end
        espHighlights[p] = nil
    end))
end
getgenv().MellSetESP = setESP

