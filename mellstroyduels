local savedAnimate = nil

local function setUnwalk(on)
    State.Unwalk = on == true
    local char = getChar()
    if not char then return end
    local anim = char:FindFirstChild("Animate")

    if on and anim and not savedAnimate then
        savedAnimate = anim
        anim.Parent  = nil
    elseif not on and savedAnimate then
        savedAnimate.Parent = char
        savedAnimate = nil
    end
end
getgenv().MellSetUnwalk = setUnwalk

