local _wasCarrying = false
local function isCarrying()
    local char = getChar()
    if not char then return false end
    for _, name in ipairs({"Carrying", "IsCarrying", "Grabbed", "Holding"}) do
        local v = char:FindFirstChild(name)
        if v and v:IsA("BoolValue") and v.Value then return true end
    end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Model") and (c.Name:lower():find("brainrot")
            or c.Name:lower():find("animal")
            or c.Name:lower():find("carry")) then
            return true
        end
    end
    return false
end

task.spawn(function()
    while task.wait(0.2) do
        if not State.AutoCarry then continue end
        local carrying = isCarrying()
        if carrying ~= _wasCarrying then
            _wasCarrying = carrying
            State.Carry = carrying
        end
    end
end)

