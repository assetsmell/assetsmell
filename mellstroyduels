local OFF_COLOR = Color3.fromRGB(40, 10, 18)
local KNOB_ON   = Color3.fromRGB(255, 255, 255)
local KNOB_OFF  = Color3.fromRGB(200, 200, 200)

local function tweenOn(slider)
    slider.BackgroundColor3 = ON_COLOR
    TweenService:Create(slider, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
        Position = UDim2.new(1, -20, 0.5, -9),
        BackgroundColor3 = KNOB_ON,
    }):Play()
end

local function tweenOff(slider)
    slider.BackgroundColor3 = OFF_COLOR
    TweenService:Create(slider, TweenInfo.new(0.2, Enum.EasingStyle.Back), {
        Position = UDim2.new(0, 2, 0.5, -9),
        BackgroundColor3 = KNOB_OFF,
    }):Play()
end

local function makeToggle(slider, initial, callback)
    if not slider then return end
    local isOn = initial == true
    -- начальное положение
    if isOn then
        slider.Position = UDim2.new(1, -20, 0.5, -9)
        slider.BackgroundColor3 = KNOB_ON
        slider.Parent.BackgroundColor3 = ON_COLOR
    else
        slider.Position = UDim2.new(0, 2, 0.5, -9)
        slider.BackgroundColor3 = KNOB_OFF
        slider.Parent.BackgroundColor3 = OFF_COLOR
    end

    slider.MouseButton1Click:Connect(function()
        isOn = not isOn
        if isOn then
            tweenOn(slider)
            slider.Parent.BackgroundColor3 = ON_COLOR
        else
            tweenOff(slider)
            slider.Parent.BackgroundColor3 = OFF_COLOR
        end
        if getgenv().MellPlayClickSound then pcall(getgenv().MellPlayClickSound) end
        if callback then pcall(callback, isOn) end
    end)
end

